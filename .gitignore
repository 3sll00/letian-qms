# 依赖
node_modules/

# 构建产物与增量编译缓存
dist/
*.tsbuildinfo

# 桌面客户端 (apps/desktop) 生成产物
apps/desktop/out/
apps/desktop/web-dist/
apps/desktop/release/
apps/desktop/release-demo*/
apps/desktop/smoke-output/

# 环境变量（.env.example 为模板，需保留）
.env
.env.local
.env.*.local

# 日志与临时文件
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# 测试与覆盖率产物
coverage/

# Schemathesis 契约测试工作区（tools/contract）
tools/contract/.venv/
tools/contract/reports/
tools/contract/.hypothesis/
tools/contract/.schemathesis/
# schemathesis 在仓库根目录直接运行时产生的状态目录
.schemathesis/

# 部署组装产物（scripts/deploy/assemble.cjs 与 pkg 输出；仅根目录组装包，scripts/deploy 源码保留）
/deploy/
/deploy.zip
/deploy-stage/
/deploy-npm-stage/
apps/api/public/

# pkg 打包临时工作区
.pkgtool/

# 构建缓存（tsBuildInfoFile 使用 .v2 后缀，*.tsbuildinfo 规则匹配不到）
*.tsbuildinfo.v2

# 旧构建备份与排查遗留
dist.old*/
dist.broken-*/
node_modules.broken/
handle.exe
install-exit.txt
tediousdir.txt
_writetest.txt

# 编辑器与系统文件
.DS_Store
Thumbs.db
.vscode/
.idea/

