# ==============================================================================
# 乐天质量管理系统 (Letian QMS) - 运行时环境变量配置模板
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 服务端核心配置 (Server Runtime)
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3100
API_HOST=0.0.0.0
WEB_PORT=31100
VITE_PORT=31100
JWT_SECRET=letian_jwt_super_secret_key_change_in_production_2026
# 开发/演示环境登录页的统一初始密码（明文比对，仅演示用；生产须换 SSO/密码哈希）
DEFAULT_LOGIN_PASSWORD=123456
# 生产环境显式放开本地「用户名+口令」登录（接入 SSO 前的内网过渡项）：
# 仅注册 /auth/login 的口令通道，/users 名单、userId 直签、缺省演示身份均不放开。
# 默认关闭；UAT/内网试运行可显式改 true，公网部署必须保持 false。
ENABLE_LOCAL_AUTH=false
# 生产 compose 首次初始化演示种子显式开关；默认 false，防止误清空业务表
SEED_DEMO=false

# 桌面客户端可选：构建期固化 API 基址（运行时也可在客户端「设置 → 服务器设置」中配置，
# 运行时配置优先级更高；未设置时浏览器端走相对路径 /api/v1 + 反向代理）
# VITE_API_BASE=http://192.168.1.10:3100/api/v1

# ------------------------------------------------------------------------------
# 2. 数据库连接池与配置 (PostgreSQL 14+)
# ------------------------------------------------------------------------------
DB_USER=letian_user
DB_PASSWORD=letian_secure_pass_2026
DB_NAME=letian_qms_db
# 本机开发库端口：5432 被本机另一项目（company-operations）的 Docker 容器转发占用，
# 乐天实例统一走 5433（docs/23 端口口径）；其他环境可按需改回 5432
DB_PORT=5433
DATABASE_URL=postgresql://letian_user:letian_secure_pass_2026@localhost:5433/letian_qms_db?schema=public
DB_POOL_MIN=2
DB_POOL_MAX=20

# ------------------------------------------------------------------------------
# 3. 外部系统集成沙箱 (ERP & MES Integration Sandbox)
# ------------------------------------------------------------------------------
MES_API_URL=https://mes-api.letian.local/api/v1
MES_API_TOKEN=mes_test_token_secret_2026
ERP_API_URL=https://erp-api.letian.local/api/v1
ERP_API_TOKEN=erp_test_token_secret_2026

# ------------------------------------------------------------------------------
# 4. 后台守护任务与运维告警 (Background Jobs & Ops Alert)
# ------------------------------------------------------------------------------
ALERT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/letian-qms-ops-alert
OUTBOX_SINK_URL=https://mes-api.letian.local/api/v1/events
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=5
MRB_TIMEOUT_HOURS=24
MRB_REMINDER_INTERVAL_MS=300000
RETENTION_CLEANUP_INTERVAL_MS=3600000
AUTHORIZATION_LOG_RETENTION_DAYS=180
IDEMPOTENCY_RETENTION_HOURS=24

# ------------------------------------------------------------------------------
# 5. 管家婆财贸双全云 ERP 测试账套 (SQL Server 2016)
# ------------------------------------------------------------------------------
ERP_DB_HOST=caimao-cmcs044-ww.rwxyun.site
ERP_DB_PORT=3433
ERP_DB_NAME=CMCSYUN442316
ERP_DB_USER=your_erp_db_user
ERP_DB_PASSWORD=your_erp_db_password
ERP_DB_ENCRYPT=true
ERP_DB_TRUST_SERVER_CERTIFICATE=true

# ------------------------------------------------------------------------------
# 6. 乐天 MES 测试数据库 (MySQL 8.0.27) - 只读限定
# ------------------------------------------------------------------------------
MES_DB_HOST=120.26.99.40
MES_DB_PORT=3306
MES_DB_NAME=mes_letian_test
MES_DB_USER=backup
MES_DB_PASSWORD=your_mes_db_password
MES_DB_CHARSET=utf8mb4
MES_DB_CONNECTION_LIMIT=5
