{
  "name": "letian-qms-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "description": "乐天紧固件质量管理系统 (Letian QMS) - 工业级质量管控与放行阻断中枢",
  "scripts": {
    "build": "pnpm --filter @letian/contracts run build && pnpm --filter @letian/domain run build && pnpm --filter @letian/application run build && pnpm --filter @letian/infrastructure run build && pnpm --filter @letian/api run build && pnpm --filter @letian/web run build",
    "test": "pnpm -r --no-bail run test",
    "typecheck": "pnpm -r --no-bail run typecheck",
    "lint": "eslint . --ext .ts,.tsx",
    "audit:code": "node scripts/testing/audit_check.js",
    "verify:oqc": "node scripts/testing/oqc-verify.cjs",
    "verify:heat-trace": "node scripts/testing/heat-batch-trace-verify.cjs",
    "verify:transfer-gate": "node scripts/testing/transfer-gate-verify.cjs",
    "verify:chain-status": "node scripts/testing/chain-status-verify.cjs",
    "verify:outsource-no": "node scripts/testing/outsource-no-check.cjs",
    "verify:inspections": "node scripts/testing/inspections-verify.cjs",
    "verify:ipqc-ledger": "node scripts/testing/ipqc-ledger-verify.cjs",
    "verify:mrb": "node scripts/testing/mrb-verify.cjs",
    "verify:mrb-wiring": "node scripts/testing/mrb-wiring-verify.cjs",
    "verify:openapi": "node scripts/testing/openapi-conformance.cjs",
    "verify:plan-match": "node scripts/testing/plan-match-ui-probe.cjs",
    "verify:dev-mode": "node scripts/testing/dev-mode-check.cjs",
    "verify:leftovers2": "node scripts/testing/leftovers2-probe.cjs",
    "verify:leftovers2:mock": "node scripts/testing/leftovers2-mock-probe.cjs",
    "verify:eol": "node scripts/testing/eol-check.cjs",
    "verify:smoke": "node scripts/testing/cdp-runner.js",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db/local-db.ps1 start",
    "db:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db/local-db.ps1 stop",
    "db:local:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db/local-db.ps1 restart",
    "db:local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db/local-db.ps1 status",
    "db:local:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db/local-db.ps1 doctor",
    "db:migrate": "pnpm --filter @letian/infrastructure run migrate:up",
    "db:migrate:down": "pnpm --filter @letian/infrastructure run migrate:down",
    "db:seed": "pnpm --filter @letian/infrastructure run seed",
    "db:recent": "node scripts/db/recent-rows.cjs",
    "db:demo:check": "pnpm --filter @letian/infrastructure exec tsx src/scripts/demo-inspections.ts check",
    "db:demo:repair": "pnpm --filter @letian/infrastructure exec tsx src/scripts/demo-inspections.ts repair",
    "db:demo:heat-trace": "pnpm --filter @letian/infrastructure exec tsx src/scripts/demo-inspections.ts seed",
    "db:test:purge": "node scripts/db/test-data-purge.cjs",
    "erp:sync:ptype": "pnpm --filter @letian/infrastructure exec tsx src/scripts/sync-ptype.ts",
    "verify:erp-readonly": "node scripts/testing/erp-readonly-check.cjs",
    "verify:erp-sync": "node scripts/testing/erp-sync-verify.cjs",
    "dev": "pnpm --filter @letian/web dev",
    "dev:web": "pnpm --filter @letian/web dev",
    "dev:api": "pnpm --filter @letian/api dev",
    "dev:all": "pnpm --parallel --filter @letian/api --filter @letian/web dev",
    "dev:mock": "pnpm --filter @letian/web dev:mock",
    "desktop:dev": "pnpm --filter @letian/desktop run dev",
    "desktop:start": "pnpm --filter @letian/web run build && pnpm --filter @letian/desktop run build && pnpm --filter @letian/desktop run copy:web && pnpm --filter @letian/desktop run start",
    "desktop:smoke": "pnpm --filter @letian/web run build:mock && pnpm --filter @letian/desktop run build && pnpm --filter @letian/desktop run copy:web && pnpm --filter @letian/desktop run smoke",
    "desktop:build": "pnpm --filter @letian/web run build && pnpm --filter @letian/desktop run build && pnpm --filter @letian/desktop run copy:web && pnpm --filter @letian/desktop run package",
    "desktop:demo": "pnpm --filter @letian/web run build:mock && pnpm --filter @letian/desktop run build && pnpm --filter @letian/desktop run copy:web && pnpm --filter @letian/desktop run package:demo",
    "verify:board-transfer-gate": "node scripts/testing/board-transfer-gate-ui-verify.cjs"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "tsx": "^4.7.2",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "prettier": "^3.2.5"
  }
}
